# Example values only: the placeholder below is NOT a production secret.
# Export these variables in your shell before running docker compose up.
# Alternatively, copy this file to worker/.env, replace the placeholder, and use:
# docker compose --env-file worker/.env up --build
WORKER_API_KEY=replace-with-a-long-random-secret
# Convex HTTP actions URL (not the .convex.cloud client URL).
# Set the same WORKER_API_KEY on the Convex deployment.
CONVEX_SITE_URL=https://your-deployment.convex.site
SIMULATION_TIMEOUT_SECONDS=400
MAX_CONCURRENT_SIMULATIONS=1
# Local dev: claim queued Convex runs and execute at localhost:8000.
# Compose enables this by default; set false for a remote push-only worker.
SIMULATION_POLLING=true
